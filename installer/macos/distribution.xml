<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>GrooveForge Bass @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="Plug-in VST3" description="/Library/Audio/Plug-Ins/VST3 (Ableton Live, Bitwig, Reaper, Cubase, FL Studio...)">
        <pkg-ref id="com.grooveforge.bass.vst3"/>
    </choice>
    <choice id="au" title="Plug-in Audio Unit" description="/Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, MainStage)">
        <pkg-ref id="com.grooveforge.bass.au"/>
    </choice>
    <choice id="app" title="Applicazione standalone" description="/Applications/GrooveForge Bass.app">
        <pkg-ref id="com.grooveforge.bass.app"/>
    </choice>
    <pkg-ref id="com.grooveforge.bass.vst3" version="@VERSION@">vst3.pkg</pkg-ref>
    <pkg-ref id="com.grooveforge.bass.au" version="@VERSION@">au.pkg</pkg-ref>
    <pkg-ref id="com.grooveforge.bass.app" version="@VERSION@">app.pkg</pkg-ref>
</installer-gui-script>
